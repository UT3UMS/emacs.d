(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(package-selected-packages
   '(ample-zen-theme auctex cargo checkbox cider cider-eval-sexp-fu clj-refactor
                     clojure-mode company company-restclient deft docker
                     docker-compose-mode dockerfile-mode dracula-theme
                     exec-path-from-shell fira-code-mode flycheck gptel
                     graphql-mode gruvbox-theme helm helm-ag helm-buffers
                     helm-info helm-mt helm-org helm-projectile helm-swoop
                     json-mode lua-mode magit markdown-mode multi-term
                     nginx-mode nix-mode ob-nix ob-restclient ob-typescript
                     openfoam org-cliplink org-download org-modern org-roam
                     org-roam-ui org-table-color ox-gemini ox-gfm ox-wk paredit
                     persistent-scratch platformio-mode prettier projectile
                     rainbow-delimiters restclient restclient-helm rust-mode
                     scad-mode seq svelte-mode syntactic-close tide ucs-utils
                     use-package web-mode yaml-mode yasnippet))
 '(safe-local-variable-directories '("/home/ktski/src/inav/"))
 '(warning-suppress-types '((comp) (initialization))))
(custom-set-faces
 ;; custom-set-faces was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(org-block ((t (:inherit block :height 0.8))))
 '(org-level-1 ((t (:inherit outline-1 :height 1.4))))
 '(org-level-2 ((t (:inherit outline-2 :height 1.3))))
 '(org-level-3 ((t (:inherit outline-3 :height 1.2))))
 '(org-level-4 ((t (:inherit outline-4 :height 1.1))))
 '(org-level-5 ((t (:inherit outline-5 :height 1.0)))))
